{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    // `vite/client` types `import.meta.glob`, which registry.ts uses to bundle the animation clips.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "vite.config.ts", "../../content/levels/*.json"]
}
