# Copy to .env (never committed). Read by `pnpm sync:content` and every dev server's vite.config (content-root.ts).

# The hosted editor and an Access *service token* for it (Cloudflare One → Access controls → Service credentials).
MP_EDITOR_URL=https://editor.playgorbo.com
MP_ACCESS_CLIENT_ID=
MP_ACCESS_CLIENT_SECRET=

# Where the live mirror lives and what the games bundle. Unset = the repo's content/ (master's).
MP_CONTENT_ROOT=.content-live
