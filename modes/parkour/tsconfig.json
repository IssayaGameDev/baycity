{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    // `vite/client` types `import.meta.glob`, which levels.ts uses to bundle content/levels/*.json.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "vite.config.ts", "../../content/*/levels/*.level.json", "../../content/*/game.json"]
}
