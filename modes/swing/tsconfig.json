{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    // `vite/client` types `import.meta.glob`, which `@mp/game-client` uses to bundle `content/`.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "../../content/levels/*.json"]
}
