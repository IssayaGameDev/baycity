{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    // `vite/client` types `import.meta.env`, which `@mp/tps` reads for the page's own address.
    "types": ["vite/client", "node"]
  },
  // `game.json` is imported by `rules.ts` (ADR 0077); levels are fetched, never imported (ADR 0169).
  "include": ["src/**/*", "vite.config.ts", "../../content/*/game.json"]
}
